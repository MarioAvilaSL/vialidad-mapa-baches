# Copia este archivo como .env y ajusta los valores (el .env NO se sube a Git).

# --- Base de datos PROPIA de este proyecto (PostgreSQL + PostGIS) ---
DATABASE_URL=postgresql+psycopg://postgres:TU_PASSWORD@localhost:5432/baches_mapa

# --- Base de datos del proyecto ORIGINAL (solo lectura; se usa desde la Fase 3) ---
# Usuario creado con sql/origen_usuario_lectura.sql. Déjala vacía si aún no la configuras.
ORIGEN_DATABASE_URL=
# Carpeta storage/ del proyecto original (de ahí se copian las imágenes de evidencia). Sin comillas. Ejemplo:
# ORIGEN_STORAGE_DIR=C:\Users\mario\Desktop\mi-proyecto-original\storage
ORIGEN_STORAGE_DIR=
# Nombre con el que se identifica el proyecto original en la base de datos propia
ORIGEN_NOMBRE=vialidad-yolo

# --- Almacenamiento propio de evidencias ---
STORAGE_DIR=storage

# --- Servidor ---
# Orígenes permitidos (CORS), separados por coma: el frontend de desarrollo (5173) y la app Android (https://localhost).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost,http://localhost,capacitor://localhost
TIMEZONE=America/Guayaquil

# --- Motor de rutas GraphHopper (Fase 5B; ver graphhopper/README.md) ---
ROUTING_URL=http://localhost:8989

# --- Acceso desde el celular (Fase 7) ---
# Clave opcional para importar y cambiar ajustes (cabecera X-Clave). Recomendada si el servidor se alcanza por la red.
API_TOKEN=
